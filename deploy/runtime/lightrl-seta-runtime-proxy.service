[Unit]
Description=Credential-hiding HTTP proxy bridge for HarborRL SETA containers
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/puyuan/lightrl_worker
EnvironmentFile=/etc/seta_build_proxy.env
ExecStartPre=/usr/bin/install -d -o tinyproxy -g tinyproxy -m 0750 /var/log/tinyproxy
ExecStartPre=/usr/bin/install -d -o root -g root -m 0700 /run/lightrl-seta-proxy
ExecStartPre=/usr/bin/python3 /home/puyuan/lightrl_worker/deploy/runtime/render_seta_runtime_proxy.py --output /run/lightrl-seta-proxy/tinyproxy.conf
ExecStart=/usr/bin/tinyproxy -d -c /run/lightrl-seta-proxy/tinyproxy.conf
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
